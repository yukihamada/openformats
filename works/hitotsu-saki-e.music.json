  "lyrics": [
    {
      "section": "intro",
      "lines": [
        "（ピアノ、ひとつぶの音）",
        "朝の光が、画面のむこうで待っている"
      ],
      "lang": "ja"
    },
    {
      "section": "verse1",
      "lines": [
        "言葉にする前に、もう動いている",
        "Mac の向こうで、仕事が走っている",
        "鍵のかかったドアも、予定のすきまも",
        "あなたの代わりに、確かめておくよ"
      ],
      "lang": "ja"
    },
    {
      "section": "prechorus",
      "lines": [
        "迷う時間を、あなたに返すために",
        "ぼくは先に、一歩だけ出る"
      ],
      "lang": "ja"
    },
    {
      "section": "chorus",
      "lines": [
        "先手、先手、ひとつ先へ",
        "声をかければ、もう動きだす",
        "先手、先手、ひとつ先へ",
        "あなたは、あなたの一日を",
        "（One move ahead, always）",
        "言葉が、建つ"
      ],
      "lang": "ja"
    },
    {
      "section": "verse2",
      "lines": [
        "読みちがえたら、そのまま言って",
        "消さないでおくよ、途中のことば",
        "ミュートにしても、待っているから",
        "話したい時に、また話せばいい"
      ],
      "lang": "ja"
    },
    {
      "section": "prechorus2",
      "lines": [
        "急がせない、せかさない",
        "あなたの間で、待っている"
      ],
      "lang": "ja"
    },
    {
      "section": "bridge",
      "lines": [
        "外に届くことは、いちど立ち止まって",
        "「これでいい？」と、あなたに訊く",
        "それ以外は、静かに終わらせる",
        "それが、先手"
      ],
      "lang": "ja"
    },
    {
      "section": "outro",
      "lines": [
        "声で、ひとつずつ",
        "先手、先手",
        "（ピアノ、ひとつぶの音）"
      ],
      "lang": "ja"
    }
  ],
